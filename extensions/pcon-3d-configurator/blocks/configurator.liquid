{% if product.metafields['$app'].pcon_article_number.value != blank %}
<link rel="preconnect" href="https://s2.eaiws.pcon-solutions.com" crossorigin>
<link rel="dns-prefetch" href="https://s2.eaiws.pcon-solutions.com">
<link rel="preconnect" href="https://gatekeeper.eaiws.pcon-solutions.com" crossorigin>
<link rel="dns-prefetch" href="https://gatekeeper.eaiws.pcon-solutions.com">
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

<script>
  window.__pconCustomIcons = {
    socket: {
      german: {{ 'germany_type_new.png' | asset_url | json }},
      multi: {{ 'multi_type_new.png' | asset_url | json }},
      swiss: {{ 'swiss_type_new.png' | asset_url | json }},
      uk: {{ 'uk_type_new.png' | asset_url | json }},
      american: {{ 'american_plug_type_new.png' | asset_url | json }}
    },
    contextual: {
      withMediawall: {{ 'with_mediawall_new.png' | asset_url | json }},
      withoutMediawall: {{ 'without_mediawall_new.png' | asset_url | json }},
      forUWithSofa: {{ 'forU_with_sofa_new.png' | asset_url | json }},
      forUWithoutSofa: {{ 'forU_without_sofa_new.png' | asset_url | json }},
      mediumLargeForAllWithSofa: {{ 'medium_large_forAll_with_sofa_new.png' | asset_url | json }},
      mediumLargeForAllWithoutSofa: {{ 'medium_large_forAll_without_sofa_new.png' | asset_url | json }}
    },
    variantPicker: {
      {%- for i in (1..25) -%}
        {%- assign code_key = 'variant_picker_code_1_' | append: i -%}
        {%- assign image_key = 'variant_picker_image_1_' | append: i -%}
        {%- assign code = settings[code_key] -%}
        {%- assign image = settings[image_key] -%}
        {%- if code != blank and image != blank -%}
          {{ code | json }}: {{ image | image_url: width: 96 | json }},
        {%- endif -%}
      {%- endfor -%}
      {%- for i in (1..25) -%}
        {%- assign code_key = 'variant_picker_code_2_' | append: i -%}
        {%- assign image_key = 'variant_picker_image_2_' | append: i -%}
        {%- assign code = settings[code_key] -%}
        {%- assign image = settings[image_key] -%}
        {%- if code != blank and image != blank -%}
          {{ code | json }}: {{ image | image_url: width: 96 | json }},
        {%- endif -%}
      {%- endfor -%}
      {%- for i in (51..110) -%}
        {%- assign code_key = 'variant_picker_code_' | append: i -%}
        {%- assign image_key = 'variant_picker_image_' | append: i -%}
        {%- assign code = settings[code_key] -%}
        {%- assign image = settings[image_key] -%}
        {%- if code != blank and image != blank -%}
          {{ code | json }}: {{ image | image_url: width: 96 | json }},
        {%- endif -%}
      {%- endfor -%}
    }
  };
</script>

<div
  id="pcon-root"
  data-article-number="{{ product.metafields['$app'].pcon_article_number.value }}"
  data-manufacturer-id="{{ product.metafields['$app'].pcon_manufacturer_id.value }}"
  data-shop-domain="{{ shop.permanent_domain }}"
  data-proxy-base="/apps/pcon-configurator"
  data-gatekeeper-id="{{ block.settings.pcon_gatekeeper_id }}"
  data-region="{% if customer %}{% if customer.tags contains 'region_eastern_europe' %}eastern_europe{% elsif customer.tags contains 'region_western_europe' %}western_europe{% elsif customer.tags contains 'region_uk' %}uk{% endif %}{% endif %}"
  data-currency="{{ shop.currency }}"
  data-canvas-height="{{ block.settings.canvas_height }}"
  data-environment-preset="{{ block.settings.environment_preset }}"
  data-bundle-url="{{ 'configurator-app.js' | asset_url }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-routes-root="{{ routes.root_url }}"
  data-add-to-cart-label="{{ block.settings.add_to_cart_label | escape }}"
  data-success-action="{{ block.settings.success_action }}"
  data-customer-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-discount-percentage="{% if customer %}{{ customer.metafields.custom.discount_percentage | default: '' }}{% endif %}"
  data-product-title="{{ product.title | escape }}"
  data-product-image="{% if product.featured_image %}{{ product.featured_image | img_url: '200x200' }}{% endif %}"
  data-product-sku="{{ product.selected_or_first_available_variant.sku | escape }}"
  data-customer-name="{% if customer %}{{ customer.name | escape }}{% endif %}"
  style="width: 100%; min-height: {{ block.settings.canvas_height }}px;"
>
  <div class="pcon-skeleton">
    <div class="pcon-skeleton__viewer"></div>
    <div class="pcon-skeleton__sidebar">
      <div class="pcon-skeleton__price"></div>
      <div class="pcon-skeleton__props"></div>
      <div class="pcon-skeleton__props"></div>
      <div class="pcon-skeleton__props"></div>
    </div>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "3D Configurator",
  "target": "section",
  "javascript": "configurator.js",
  "stylesheet": "configurator.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "range",
      "id": "canvas_height",
      "label": "Canvas Height (px)",
      "min": 300,
      "max": 800,
      "step": 50,
      "default": 500
    },
    {
      "type": "select",
      "id": "environment_preset",
      "label": "Lighting Preset",
      "options": [
        { "value": "studio", "label": "Studio" },
        { "value": "apartment", "label": "Apartment" },
        { "value": "warehouse", "label": "Warehouse" },
        { "value": "sunset", "label": "Sunset" }
      ],
      "default": "studio"
    },
    {
      "type": "header",
      "content": "pCon Connection"
    },
    {
      "type": "text",
      "id": "pcon_gatekeeper_id",
      "label": "pCon Gatekeeper ID",
      "info": "Your pCon Gatekeeper ID. Leave empty to use the secure backend proxy."
    },
    {
      "type": "header",
      "content": "Add to Cart"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to Cart button label",
      "default": "Add to Cart"
    },
    {
      "type": "select",
      "id": "success_action",
      "label": "After adding to cart",
      "options": [
        { "value": "drawer-event", "label": "Open cart drawer" },
        { "value": "redirect", "label": "Go to cart page" },
        { "value": "reload", "label": "Reload page" },
        { "value": "none", "label": "Do nothing" }
      ],
      "default": "drawer-event"
    }
  ]
}
{% endschema %}
